#include atoms_red
#include cb05_sorg_aq.spc
#include cb05_sorg_aq.eqn

#INLINE F90_GLOBAL
! ---------------------------------------------------------------------------
! Externals that WRF normally supplies through its grid coupling.
! We supply them ourselves so the mechanism can run standalone.
!
!  * C_M   : air number density [molecules/cm3]
!  * j(:)  : photolysis rate constants; the KPP equation file refers to them
!            as j(Pj_xxx), i.e. j is an ARRAY and Pj_xxx is the index.
! ---------------------------------------------------------------------------
REAL(KIND=dp) :: C_M
REAL(KIND=dp) :: j(17)

INTEGER, PARAMETER :: Pj_no2    = 1
INTEGER, PARAMETER :: Pj_o33p   = 2
INTEGER, PARAMETER :: Pj_o31d   = 3
INTEGER, PARAMETER :: Pj_no3o   = 4
INTEGER, PARAMETER :: Pj_no3o2  = 5
INTEGER, PARAMETER :: Pj_hno2   = 6
INTEGER, PARAMETER :: Pj_h2o2   = 7
INTEGER, PARAMETER :: Pj_hno4   = 8
INTEGER, PARAMETER :: Pj_hno3   = 9
INTEGER, PARAMETER :: Pj_n2o5   = 10
INTEGER, PARAMETER :: Pj_pan    = 11
INTEGER, PARAMETER :: Pj_ch2or  = 12
INTEGER, PARAMETER :: Pj_ch2om  = 13
INTEGER, PARAMETER :: Pj_ch3cho = 14
INTEGER, PARAMETER :: Pj_cl2    = 15
INTEGER, PARAMETER :: Pj_hocl   = 16
INTEGER, PARAMETER :: Pj_fmcl   = 17
#ENDINLINE

#INLINE F90_INIT
! ---------------------------------------------------------------------------
! Minimal test unit: closed, autonomous box (no emissions, no deposition,
! no dilution).  Constant photolysis frequencies (typical July midday,
! clear sky, surface).  Units: molecules/cm3 (CFACTOR = 1).
! ppb -> molecules/cm3 factor: 2.45D+10  (298 K, 1 atm)
! ---------------------------------------------------------------------------
TSTART = 0.0_dp
TEND   = 86400.0_dp
DT     = 1800.0_dp

TEMP  = 298.0_dp
C_M   = 2.45D+19

! Photolysis frequencies j(1:17) [1/s]
j      = 0.0_dp
j(Pj_no2)    = 7.7D-3
j(Pj_o33p)   = 3.8D-4
j(Pj_o31d)   = 1.0D-5
j(Pj_no3o)   = 2.2D-4
j(Pj_no3o2)  = 4.5D-4
j(Pj_hno2)   = 8.0D-4
j(Pj_h2o2)   = 1.0D-6
j(Pj_hno4)   = 7.0D-7
j(Pj_hno3)   = 7.8D-7
j(Pj_n2o5)   = 1.0D-3
j(Pj_pan)    = 4.2D-5
j(Pj_ch2or)  = 1.0D-4
j(Pj_ch2om)  = 3.5D-4
j(Pj_ch3cho) = 1.0D-5
j(Pj_cl2)    = 1.0D-3
j(Pj_hocl)   = 3.0D-4
j(Pj_fmcl)   = 2.0D-6

! Initial concentrations (typical urban, molecules/cm3)
C(ind_no)   = 20.0D+00 * 2.45D+10
C(ind_no2)  = 30.0D+00 * 2.45D+10
C(ind_o3)   = 60.0D+00 * 2.45D+10
C(ind_co)   = 150.0D+00 * 2.45D+10
C(ind_ch4)  = 1900.0D+00 * 2.45D+10
C(ind_hono) = 1.0D+00 * 2.45D+10
C(ind_hno3) = 5.0D+00 * 2.45D+10
C(ind_h2o2) = 2.0D+00 * 2.45D+10
C(ind_so2)  = 5.0D+00 * 2.45D+10
C(ind_form) = 4.0D+00 * 2.45D+10
C(ind_ald2) = 1.5D+00 * 2.45D+10
C(ind_aldx) = 1.0D+00 * 2.45D+10
C(ind_pan)  = 1.5D+00 * 2.45D+10
C(ind_mgly) = 0.5D+00 * 2.45D+10
C(ind_to2)  = 1.0D+00 * 2.45D+10
C(ind_xo2)  = 1.0D+00 * 2.45D+10
C(ind_meo2) = 1.0D+00 * 2.45D+10
C(ind_c2o3) = 1.0D+00 * 2.45D+10
C(ind_oh)   = 2.0D-4 * 2.45D+10
C(ind_ho2)  = 5.0D-4 * 2.45D+10
C(ind_no3)  = 1.0D-3 * 2.45D+10
C(ind_tol)  = 5.0D+00 * 2.45D+10
C(ind_xyl)  = 5.0D+00 * 2.45D+10
C(ind_pna)  = 2.0D+00 * 2.45D+10
C(ind_isop) = 1.0D+00 * 2.45D+10
C(ind_terp) = 0.3D+00 * 2.45D+10
C(ind_ole)  = 3.0D+00 * 2.45D+10
C(ind_iole) = 1.0D+00 * 2.45D+10
C(ind_alkh) = 20.0D+00 * 2.45D+10
C(ind_par)  = 500.0D+00 * 2.45D+10
C(ind_etha) = 500.0D+00 * 2.45D+10
C(ind_eth)  = 20.0D+00 * 2.45D+10
C(ind_meoh) = 2.0D+00 * 2.45D+10
C(ind_etoh) = 2.0D+00 * 2.45D+10
#ENDINLINE

#INLINE F90_RATES
! ---------------------------------------------------------------------------
! Rate law functions, verbatim from
!   WRF/chem/KPP/kpp/kpp-2.1/util/WRF_conform/WRFUserRateLaws.f90
! (KPP_REAL -> REAL(KIND=dp))
! ---------------------------------------------------------------------------
    REAL(KIND=dp) FUNCTION ARR( A0,B0,C0, TEMP )
      REAL(KIND=dp) :: TEMP
      REAL(KIND=dp) A0,B0,C0
      ARR =  A0 * EXP( -B0 /TEMP ) * (TEMP/300._dp)**C0
    END FUNCTION ARR

   REAL(KIND=dp) FUNCTION ARR2( A0,B0, TEMP )
      REAL(KIND=dp) :: TEMP
      REAL(KIND=dp) A0,B0
      ARR2 = A0 * EXP( -B0 /TEMP )
   END FUNCTION ARR2

   REAL(KIND=dp) FUNCTION EP2( A0,C0,A2,C2,A3,C3,TEMP,cair)
      REAL(KIND=dp) :: TEMP
      REAL(KIND=dp) :: cair
      REAL(KIND=dp) A0,C0,A2,C2,A3,C3
      REAL(KIND=dp) K0,K2,K3
      K0 = A0 * EXP(-C0 /TEMP)
      K2 = A2 * EXP(-C2 /TEMP)
      K3 = A3 * EXP(-C3 /TEMP)
      K3 = K3 * cair
      EP2 = K0 + K3/(1._dp+K3/K2 )
   END FUNCTION EP2

    REAL(KIND=dp) FUNCTION EP3(A1,C1,A2,C2,TEMP,cair)
      REAL(KIND=dp) :: TEMP
      REAL(KIND=dp) :: cair
      REAL(KIND=dp) A1, C1, A2, C2
      REAL(KIND=dp) K1, K2
      K1 = A1 * EXP(-C1 /TEMP)
      K2 = A2 * EXP(-C2 /TEMP)
      EP3 = K1 + K2*cair
    END FUNCTION EP3

    REAL(KIND=dp) FUNCTION FALLX( A0,B0,C0,A1,B1,C1,CF,TEMP,cair)
      INTRINSIC LOG10
      REAL(KIND=dp) :: TEMP
      REAL(KIND=dp) :: cair
      REAL(KIND=dp) A0,B0,C0,A1,B1,C1,CF
      REAL(KIND=dp) K0, K1
      K0 = A0 * EXP(-B0 /TEMP)* (TEMP/300._dp)**C0
      K1 = A1 * EXP(-B1 /TEMP)* (TEMP/300._dp)**C1
      K0 = K0 * cair
      K1 = K0/K1
      FALLX = (K0/(1._dp+K1))*CF**(1._dp/(1._dp+(LOG10(K1))**2))
    END FUNCTION FALLX

    REAL(KIND=dp) FUNCTION F2( A0,B0,C0,A1,B1,C1,CF,CN,TEMP,cair)
      INTRINSIC LOG10
      REAL(KIND=dp) :: TEMP
      REAL(KIND=dp) :: cair
      REAL(KIND=dp) A0,B0,C0,A1,B1,C1,CF,CN
      REAL(KIND=dp) K0, K1
      K0 = A0 * EXP(-B0 /TEMP)* (TEMP/300._dp)**C0
      K1 = A1 * EXP(-B1 /TEMP)* (TEMP/300._dp)**C1
      K0 = K0 * cair
      K1 = K0/K1
      F2 = (K0/(1._dp+K1))*CF**(1._dp/(1._dp+(LOG10(K1)/CN)**2))
    END FUNCTION F2

    REAL(KIND=dp) FUNCTION TROE(k0_300K,n,kinf_300K,m,temp,cair)
      INTRINSIC LOG10
      REAL(KIND=dp), INTENT(IN) :: temp
      REAL(KIND=dp), INTENT(IN) :: cair
      REAL(KIND=dp), INTENT(IN) :: k0_300K
      REAL(KIND=dp), INTENT(IN) :: n
      REAL(KIND=dp), INTENT(IN) :: kinf_300K
      REAL(KIND=dp), INTENT(IN) :: m
      REAL(KIND=dp) :: zt_help, k0_T, kinf_T, k_ratio
      zt_help = 300._dp/temp
      k0_T    = k0_300K   * zt_help**(n) * cair
      kinf_T  = kinf_300K * zt_help**(m)
      k_ratio = k0_T/kinf_T
      TROE   = k0_T/(1._dp+k_ratio)*0.6_dp**(1._dp/(1._dp+LOG10(k_ratio)**2))
    END FUNCTION TROE

    REAL(KIND=dp) FUNCTION TROEE(A, B, k0_300K,n,kinf_300K,m,temp,cair)
      INTRINSIC LOG10
      REAL(KIND=dp), INTENT(IN) :: temp
      REAL(KIND=dp), INTENT(IN) :: cair
      REAL(KIND=dp), INTENT(IN) :: k0_300K
      REAL(KIND=dp), INTENT(IN) :: n
      REAL(KIND=dp), INTENT(IN) :: kinf_300K
      REAL(KIND=dp), INTENT(IN) :: m
      REAL(KIND=dp), INTENT(IN) :: A, B
      REAL(KIND=dp) :: zt_help, k0_T, kinf_T, k_ratio, troe
      zt_help = 300._dp/temp
      k0_T    = k0_300K   * zt_help**(n) * cair
      kinf_T  = kinf_300K * zt_help**(m)
      k_ratio = k0_T/kinf_T
      troe   = k0_T/(1._dp+k_ratio)*0.6_dp**(1._dp/(1._dp+LOG10(k_ratio)**2))
      TROEE = A * EXP( - B / temp) * troe
    END FUNCTION TROEE

   REAL(KIND=dp) FUNCTION THERMAL_T2(c, d ,temp)
      REAL(KIND=dp), INTENT(IN) :: temp
      REAL(KIND=dp), INTENT(IN) :: c, d
      THERMAL_T2 = temp**2._dp * c * EXP(- d / temp)
   END FUNCTION THERMAL_T2

! ---------------------------------------------------------------------------
! Mechanism-specific rate law carried over from the WRF cb05_sorg_aq.def
! ---------------------------------------------------------------------------
REAL(KIND=dp) FUNCTION k46( TEMP, C_M )
    REAL(KIND=dp), INTENT(IN) :: temp, c_m
    REAL(KIND=dp) :: k0, k2, k3
   k0=7.2E-15_dp * EXP(785._dp/TEMP)
   k2=4.1E-16_dp * EXP(1440._dp/TEMP)
   k3=1.9E-33_dp * EXP(725._dp/TEMP)
   k46=k0+k3/(1+k3/k2)
END FUNCTION k46
#ENDINLINE
